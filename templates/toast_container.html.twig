{% if auto_load_assets %}
	<style>
		{{source('@AsmittaToast/css/toast.css.twig')}}
		{% if show_progress_bar %}
			{{source('@AsmittaToast/css/toast-progress-bar.css.twig')}}
		{% endif %}
	</style>
{% endif %}

<div class="asmitta-toast-container asmitta-position-fixed {{ position }} asmitta-p-3">
	{% for type, messages in flashes %}
		{% for message in messages %}
			{% include template with {
                'type': type,
                'message': message,
                'toast_type': toast_types[type] ?? 'info',
                'timer': timer,
                'is_dismissible': is_dismissible
            } %}
		{% endfor %}
	{% endfor %}
</div>

{% if auto_load_assets %}
	<script src="{{ asset('bundles/asmittaToast/js/toast.js') }}"></script>
{% endif %}
