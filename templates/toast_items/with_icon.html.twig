{% set accessibility_attr = {
    'success': 'role="status" aria-live="polite"',
    'warning': 'role="alert" aria-live="assertive"',
    'danger': 'role="alert" aria-live="assertive"',
    'info': 'role="status" aria-live="polite"'
}[type] ?? 'role="alert"' %}

{% set icon = {
    info: 'bi-info-circle',
    danger: 'bi-exclamation-circle',
    warning: 'bi-exclamation-triangle',
    success: 'bi-check-circle'
}[type] ?? 'bi-info-circle' %}

<div class="asmitta-toast{% if type != 'info' %} asmitta-toast-border-{{ type }}{% endif %}" {{ accessibility_attr|raw }} data-asmitta-autohide="{{ timer > 0 ? 'true' : 'false' }}" data-asmitta-delay="{{ timer }}">
	<div class="asmitta-toast-header{% if type != 'info' %} asmitta-toast-bg-{{ type }}{% endif %}">
		<i class="{{ icon }} asmitta-toast-header-icon"></i>
		<strong class="asmitta-toast-title">{{ toast_type|trans({}, 'asmitta_toast_bundle') }}</strong>

		{% if is_dismissible %}
			<button type="button" class="asmitta-toast-close" data-asmitta-dismiss="toast"></button>
		{% endif %}
	</div>
	<div class="asmitta-toast-body" style="position: relative;">
		<div>
			{{ message }}
		</div>

		{% if show_progress_bar and timer > 0 %}
			<div class="asmitta-toast-progress-bar active" style="--asmitta-toast-progress-timer: {{ timer }}ms; --asmitta-toast-progress-color: var(--asmitta-color-{{ type }})"></div>
		{% endif %}
	</div>
</div>
