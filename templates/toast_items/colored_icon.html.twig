{% set accessibility_attr = {
    'success': 'role="status" aria-live="polite"',
    'warning': 'role="alert" aria-live="assertive"',
    'danger': 'role="alert" aria-live="assertive"',
    'info': 'role="status" aria-live="polite"'
}[type] ?? 'role="alert"' %}

{% set icon = {
    info: 'bi-info-circle-fill',
    danger: 'bi-exclamation-circle-fill',
    warning: 'bi-exclamation-triangle-fill',
    success: 'bi-check-circle-fill'
}[type] ?? 'bi-info-circle' %}

<div class="asmitta-toast asmitta-toast-with-icon" {{ accessibility_attr|raw }} data-asmitta-autohide="{{ timer > 0 ? 'true' : 'false' }}" data-asmitta-delay="{{ timer }}">
	<i class="{{ icon }} asmitta-toast-icon asmitta-toast-text-{{ type }}"></i>

	<div class="asmitta-toast-content">
		<div class="asmitta-toast-header">
			<strong class="asmitta-toast-title">{{ toast_type|trans({}, 'asmitta_toast_bundle') }}</strong>

			{% if is_dismissible %}
				<button type="button" class="asmitta-toast-close" data-asmitta-dismiss="toast"></button>
			{% endif %}
		</div>
		<div class="asmitta-toast-body">
			{{ message }}
		</div>
	</div>

	{% if show_progress_bar and timer > 0 %}
		<div class="asmitta-toast-progress-bar active" style="--asmitta-toast-progress-timer: {{ timer }}ms; --asmitta-toast-progress-color: var(--asmitta-color-{{ type }})"></div>
	{% endif %}
</div>
